# Copy this file to .env and replace the placeholder with your own key.
# Get a free key at https://www.omdbapi.com/apikey.aspx
# NEVER commit the .env file.

OMDB_API_KEY=your_omdb_api_key_here

# Maximum OMDb requests per pipeline run.
# The free tier allows 1,000 requests/day; staying below it leaves headroom
# for manual testing. The pipeline stops calling the API at this limit and
# resumes from its cache on the next run.
OMDB_MAX_API_CALLS=950